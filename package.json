{
  "name": "avni-skills-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "API + agent runtime that wraps avniproject/avni-skills as Claude-Agent-SDK-driven endpoints. BYO Anthropic API key.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "test:entities": "node --test tests/entities/*.test.cjs",
    "test:bundle": "node tests/bundle-harness.cjs",
    "test:multi-org": "node scripts/multi-org-run.js",
    "test": "npm run test:entities",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node scripts/sdk-cli.mjs",
    "verify": "node scripts/sdk-cli.mjs --demo",
    "verify:dryrun": "bash -c 'node scripts/dryrun-phase-4.mjs --forms \"$0\" --modelling \"$1\" --org \"${2:-Demo}\"'",
    "corpus:validate": "node tests/corpus/run.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/avniproject/avni-skills-sdk.git"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.128",
    "acorn": "^8.16.0",
    "acorn-walk": "^8.3.5",
    "archiver": "^7.0.1",
    "express": "^4.21.2"
  }
}
