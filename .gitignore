# Dependencies
node_modules/

# Lockfile — keep committed for reproducible installs
# (intentionally NOT in .gitignore)

# Build artifacts
dist/
*.log
.DS_Store

# Generated bundles (ALL of them — these are output, not source)
multi-org-out/
out/
output/
output-bundle/
**/bundle-*/
**/bundle-*.zip
**/concepts.json
**/formMappings.json
**/operationalSubjectTypes.json
**/operationalPrograms.json
**/operationalEncounterTypes.json
# Allow our actual config + lib files
!package.json
!**/package-lock.json
!**/lib/**

# PROPRIETARY DATA — never commit these
# Real org SRS files, production bundles, and server logs are NGO/client data.
# This SDK ships only synthetic in-memory fixtures (see tests/entities/lib/fixture.js).
*.xlsx
*.xls
*.xlsm
fixtures/
**/prod-*/
**/*-prod-*
*-errors.csv
**/training_data/
# Doorstep proprietary org data — local-only, never committed (rule §2).
# (*.zip is NOT globally ignored, so guard the whole dir + its artifacts.)
tests/resources/doorstep/*.xlsx
tests/resources/doorstep/*.zip
tests/resources/doorstep/uat/
tests/resources/doorstep/parity-gap.json
tests/resources/doorstep/*.local.mjs

# All proprietary org corpora (udgam, bks, gubbachi, …) — local-only (rule §2).
# READMEs stay committed; data (xlsx/zip/json + extracted dirs) never does.
tests/resources/*/*.xlsx
tests/resources/*/*.zip
tests/resources/*/*.json

# Superpowers SDD scratch (progress ledger, task briefs) — never committed
.superpowers/

# Env / secrets
.env
.env.*
!.env.example

# Local IDE state
.idea/
.vscode/
.cursor/

# Temp
*.tmp
/tmp/
.cache/

# Stray shell-redirect artifacts (e.g. accidental `> to` typos)
/to


# Sub-agent worktree artifacts (Claude Code harness creates these).
# Ignore everything under .claude/ EXCEPT the committed Workflow-tool scripts.
# The recursive negation also overrides the earlier **/*-prod-* rule for the
# bundle-to-prod-ready.js workflow script.
.claude/*
!.claude/workflows/
!.claude/workflows/**

# corpus:parity transient failure artifact (never commit — gained.json + baseline are the committed witnesses)
tests/corpus/parity/lost.json

# Acceptance-harness run artifact
acceptance-report.json
